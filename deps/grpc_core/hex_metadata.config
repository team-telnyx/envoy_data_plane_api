{<<"links">>,[{<<"GitHub">>,<<"https://github.com/elixir-grpc/grpc_core">>}]}.
{<<"name">>,<<"grpc_core">>}.
{<<"version">>,<<"1.0.5">>}.
{<<"description">>,<<"Core gRPC types, codecs, and utilities for Elixir">>}.
{<<"elixir">>,<<"~> 1.15">>}.
{<<"files">>,
 [<<"lib">>,<<"lib/grpc">>,<<"lib/grpc/transport">>,
  <<"lib/grpc/transport/http2.ex">>,<<"lib/grpc/transport/utils.ex">>,
  <<"lib/grpc/time_utils.ex">>,<<"lib/grpc/compressor">>,
  <<"lib/grpc/compressor/gzip.ex">>,<<"lib/grpc/service.ex">>,
  <<"lib/grpc/google">>,<<"lib/grpc/google/rpc.ex">>,
  <<"lib/grpc/credential.ex">>,<<"lib/grpc/codec.ex">>,
  <<"lib/grpc/message.ex">>,<<"lib/grpc/rpc_error.ex">>,
  <<"lib/grpc/compressor.ex">>,<<"lib/grpc/status.ex">>,<<"lib/grpc/codec">>,
  <<"lib/grpc/codec/proto.ex">>,<<"lib/grpc/codec/erlpack.ex">>,
  <<"lib/grpc/codec/json.ex">>,<<"lib/grpc/codec/web_text.ex">>,
  <<"lib/grpc/telemetry.ex">>,<<"lib/grpc_core.ex">>,<<"mix.exs">>,
  <<"README.md">>,<<"LICENSE">>]}.
{<<"app">>,<<"grpc_core">>}.
{<<"licenses">>,[<<"Apache-2.0">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"protobuf">>},
   {<<"app">>,<<"protobuf">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 0.17">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"jason">>},
   {<<"app">>,<<"jason">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<">= 0.0.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"telemetry">>},
   {<<"app">>,<<"telemetry">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 1.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"googleapis">>},
   {<<"app">>,<<"googleapis">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 0.1.0">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"build_tools">>,[<<"mix">>]}.
